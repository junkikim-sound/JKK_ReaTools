desc:JKK_Meter
//author: Junki Kim
options:no_meter
options:gmem=JKK_Meter_Mem

// --- 슬라이더 설정 ---
slider1:0.65<0,1,0.001>Visual Gain
// slider2:0.25<0,1,0.001>Spectrum Floor (Macro %)

@init
    slider2 = 0.25;

    idx = 0;
    buf_len = 100000; // 2초 분량 버퍼
    fft_size = 4096;
    fft_buf = 500000; 
    window = 600000;
    fft_idx = 0;

    i = 0;
    loop(fft_size,
        window[i] = 0.54 - 0.46 * cos(2 * $pi * i / (fft_size - 1));
        i += 1;
    );

@slider
    gmem[2] = slider1;
    gmem[3] = slider2;

@block
    gmem[1] = srate;

@sample
    in_l = spl0;
    in_r = spl1;
    in_mono = (in_l + in_r) * 0.5;

    // [중요] 메모리 주소 재배치
    // Left: 10,000 ~ 110,000
    gmem[10000 + idx] = in_l;
    // Right: 110,000 ~ 210,000 (겹치지 않게 이동)
    gmem[110000 + idx] = in_r;
    
    idx = (idx + 1) % buf_len;
    gmem[0] = idx;

    // FFT 처리
    fft_buf[fft_idx] = in_mono * window[fft_idx];
    fft_buf[fft_size + fft_idx] = 0;
    fft_idx += 1;

    fft_idx >= fft_size ? (
        fft_idx = 0;
        memcpy(700000, fft_buf, fft_size * 2); // 임시 버퍼도 안전한 곳으로
        fft(700000, fft_size);
        fft_permute(700000, fft_size);
        
        k = 0;
        loop(fft_size/2,
            re = 700000[k*2];
            im = 700000[k*2+1];
            // [중요] 스펙트럼 데이터 저장 위치를 300,000번지로 이동
            gmem[300000 + k] = sqrt(re*re + im*im);
            k += 1;
        );
    );

@gfx 120 30
    gfx_set(0, 1, 0, 1);
    gfx_x = 5; gfx_y = 10;
    gfx_drawstr("DATA SERVER ACTIVE");